 R←Version path;base;sha;tag;path;vfile;p∆
⍝ Returns Konducta version from VERSION file
⍝ In development: appends -dev+SHA (e.g., "1.0.0-dev+a3f5c2b")
⍝ On tagged release: clean version (e.g., "1.0.0")
⍝ ⍵: optional path to repo root (default: current #.Home)
 :If 0=≢path
 :AndIf 9=#.⎕NC'Home'
     path←#.Home
 :EndIf
 :If ~⎕NEXISTS path,'VERSION'
 :AndIf ⎕NEXISTS(p∆←1⊃⎕NPARTS(-∨/'\/'=⊃⌽path)↓path),'VERSION'
     path←p∆
 :EndIf
 vfile←path,'VERSION'
 :If ⎕NEXISTS vfile
     base←⊃1⊃⎕NGET vfile 1
         ⍝ Check if we're on a tagged release
     :Trap 0
         tag←⊃⎕SH'cd "',path,'" && git describe --exact-match --tags 2>/dev/null'
         :If 0<≢tag
             R←base  ⍝ On tag: return clean version
             →0
         :EndIf
     :EndTrap
         ⍝ Development: append git SHA
     :Trap 0
         sha←⊃⎕SH'cd "',path,'" && git rev-parse --short HEAD 2>/dev/null'
         :If 0<≢sha
             R←base,'-dev+',sha
         :Else
             R←base
         :EndIf
     :Else
         R←base
     :EndTrap
 :Else
     R←'N/A'
 :EndIf
