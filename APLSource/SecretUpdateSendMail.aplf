 ok←SecretUpdateSendMail subject body;cfg;to;from;srv;port;ssl;user;pswd;⎕USING;smtp;msg
⍝ Send confirmation mail for secret updates using dedicated SMTP settings in Konducta.json5.
 ok←0
 cfg←#.Config
 to←{2=cfg.⎕NC'secret_update_confirm_to':cfg.secret_update_confirm_to ⋄ ''}⍬
 from←{2=cfg.⎕NC'secret_update_smtp_from':cfg.secret_update_smtp_from ⋄ ''}⍬
 srv←{2=cfg.⎕NC'secret_update_smtp_server':cfg.secret_update_smtp_server ⋄ ''}⍬
 :If (0=≢to)∨(0=≢from)∨(0=≢srv)
     →0
 :EndIf
 port←{2=cfg.⎕NC'secret_update_smtp_port':cfg.secret_update_smtp_port ⋄ 587}⍬
 ssl←{2=cfg.⎕NC'secret_update_smtp_secure':cfg.secret_update_smtp_secure ⋄ 1}⍬
 user←{2=cfg.⎕NC'secret_update_smtp_user':cfg.secret_update_smtp_user ⋄ ''}⍬
 pswd←{2=cfg.⎕NC'secret_update_smtp_pswd':cfg.secret_update_smtp_pswd ⋄ ''}⍬

 ⎕USING←'System' 'System.Net' 'System.Net.Mail'
 :Trap 0
     smtp←⎕NEW SmtpClient(srv port)
     smtp.EnableSsl←ssl
     :If 0<≢user
         smtp.Credentials←⎕NEW NetworkCredential(user pswd)
     :EndIf
     msg←⎕NEW MailMessage
     msg.From←⎕NEW MailAddress from
     msg.To.Add to
     msg.Subject←subject
     msg.Body←body
     smtp.Send msg
     ok←1
 :Else
     ok←0
 :EndTrap
