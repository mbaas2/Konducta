 LoadHandlerRepos repos;repo;path;ns
⍝ Load handler code from configured repositories
⍝ ⍵ = handlerRepos array from Config
⍝ All repos must have APLSource/ structure
⍝ Returns: nothing (side effect: imports code into #.Handlers.*)
⍝ Skips re-importing if handler already loaded
 '#.Handlers'⎕NS''
 :If 0=≢repos
     ⎕←'No handler repositories configured'
     :Return
 :EndIf
 :For repo :In repos
     :If 0<≢path←repo.path
         ns←repo.namespace
         :If 0=⎕NC ns  ⍝ Check if namespace already exists
             ns ⎕NS''
             ⎕SE.Link.Import ns(path,'APLSource')
             ⍎ns,'.RepoPath←''',path,''''
             ⎕←'Handler repo "',repo.name,'" loaded into ',ns,' from ',path,'APLSource'
         :Else
             :If 0=(⍎ns).⎕NC'RepoPath'
                 ⍎ns,'.RepoPath←''',path,''''
             :EndIf
             ⎕←'Handler repo "',repo.name,'" already loaded in ',ns
         :EndIf
     :Else
         ⎕←'Skipping handler repo "',repo.name,'" (no path configured)'
     :EndIf
 :EndFor
