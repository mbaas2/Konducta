 LoadHandlerRepos repos;repo;path;ns;ver
⍝ Load handler code from configured repositories
⍝ ⍵ = handlerRepos array from Config
⍝ All repos must have APLSource/ structure
⍝ Returns: nothing (side effect: imports code into #.Handlers.*)
⍝ Skips re-importing if handler already loaded
⍝ Sets <ns>.version from the repo's VERSION file (via #.Version)
 '#.Handlers'⎕NS''
 :If 0=≢repos
     'INFO' 'SYS'#.Log'No handler repositories configured'(#.DATA,'SYS/')
     :Return
 :EndIf
 :For repo :In repos
     :If 0<≢path←repo.path
         ns←repo.namespace
         :If 0=⎕NC ns  ⍝ Check if namespace already exists
             ns ⎕NS''
             :If '1'≡1⊃160⌶'KONDUCTA_DEVTMODE'
                 ver←⎕SE.Link.Create ns(path,'APLSource')
                 'INFO' 'SYS'#.Log('Linked handler repo "',repo.name,'" into ',ns,' from ',path,'APLSource, result: ',ver)(#.DATA,'SYS/')
             :Else
                 ver←⎕SE.Link.Import ns(path,'APLSource')
                 'INFO' 'SYS'#.Log('Imported handler repo "',repo.name,'" into ',ns,' from ',path,'APLSource, result: ',ver)(#.DATA,'SYS/')
             :EndIf

             ⍎ns,'.RepoPath←''',path,''''
             'INFO' 'SYS'#.Log('Handler repo "',repo.name,'" loaded into ',ns,' from ',path,'APLSource')(#.DATA,'SYS/')
         :Else
             :If 0=(⍎ns).⎕NC'RepoPath'
                 ⍎ns,'.RepoPath←''',path,''''
             :EndIf
             'INFO' 'SYS'#.Log('Handler repo "',repo.name,'" already loaded in ',ns)(#.DATA,'SYS/')
         :EndIf
         ⍝ Read handler's own VERSION file and publish as <ns>.version
         ver←{~⎕NEXISTS file←⍵,'VERSION':'N/A' ⋄ #.Version ⍵}path
         (⍎repo.namespace,'.',{2=repo.⎕NC'class':repo.class ⋄ ((⍎ns).⎕nl-9){(⍺⍳⍥⎕c⍵)⊃⍺}⊂repo.name}0).SetVersion ver
         'INFO' 'SYS'#.Log('Handler repo "',repo.name,'" version: ',ver)(#.DATA,'SYS/')
         :If ⎕NEXISTS path,'HTML/'
             :If ~⎕NEXISTS HTMLFOLDER ⋄ ⎕NCREATE HTMLFOLDER ⋄ :EndIf
             (HTMLFOLDER,'/',repo.name)⎕NCOPY path,'HTML'
         :EndIf
     :Else
         'INFO' 'SYS'#.Log('Skipping handler repo "',repo.name,'" (no path configured)')(#.DATA,'SYS/')
     :EndIf
 :EndFor
