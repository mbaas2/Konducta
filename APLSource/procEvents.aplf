 procEvents;f;E;R;z;⎕PATH;ac;if;n;CFG
⍝ check event queue and process waiting events...

 :For f :In ⊃0(⎕NINFO ⎕OPT'Wildcard' 1)DATA,'/evq/*.json5'
     E←0(⎕JSON⍠'Dialect' 'JSON5')1⊃⎕NGET f
     E.EventQueue_File←f
     CFG←#.Triggers.Config⍎E.cfg   ⍝ get config of trigger
     ⎕←'[procEvents] ',E.cfg,' von: ',E.sender,' / Betreff: ',E.subject

     :For n :In rules.⎕NL ¯9
         R←rules⍎n
        ⍝ check if a rule applies...
         (#.Triggers.handlerMap⍎E.cfg) applyRule R E
     :EndFor
     :if ~#.Config.debug _hasBitSet 4
     :andif ⎕nexists f
          ⎕←'[EVQ] move: ',f,' -> ',DATA,'/evq/done/'
        :Trap 0
            ('INFO' 'SYS')(#.Triggers.handlerMap⍎E.cfg).Log'[EVQ] move: ',f,' -> ',DATA,'/evq/done/'
        :EndTrap
        (DATA,'/evq/done/')⎕nmove f
     :endif
 :EndFor
