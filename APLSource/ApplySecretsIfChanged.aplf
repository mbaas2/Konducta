 changed←ApplySecretsIfChanged nul;f;utc;secrets;cfgRoot
⍝ Reload local secrets file only when it changed, then merge into runtime config.
 changed←0
 :If 0=#.⎕NC'Home'
     →0
 :EndIf
 cfgRoot←{9=#.⎕NC'ConfigRoot':#.ConfigRoot ⋄ #.Home,'Config/'}⍬
 f←cfgRoot,'secrets.local.json5'
 :If ~⎕NEXISTS f
     →0
 :EndIf
 utc←⊃13 ⎕NINFO f
 :If (0=#.⎕NC'SecretsUTC')∨utc>#.SecretsUTC
     :Trap 0
         secrets←(⎕JSON⍠'Dialect' 'JSON5')1⊃⎕NGET f
         {}ApplySecrets secrets
         #.SecretsUTC←utc
         changed←1
     :Else
         changed←0
     :EndTrap
 :EndIf
