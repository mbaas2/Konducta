r←{l}secret_update r;expected;auth;token;payload;secrets;pending;f;ids;id;sec;flds;summary;code;ok;pool;line;i;cfgRoot
⍝ Stage secret updates and send a confirmation mail.
⍝ Activation requires a second call to /secret_update_confirm with the mailed code.

 expected←{2=#.Config.⎕NC'secret_update_token':#.Config.secret_update_token ⋄ ''}⍬
 :If 0=≢expected
     r.Response.StatusCode←500
     r←'{"ok":false,"error":"secret_update_token not configured"}'
     →0
 :EndIf

 :Trap 0
     payload←⎕JSON r.Body
 :Else
     r.Response.StatusCode←400
     r←'{"ok":false,"error":"invalid JSON body"}'
     →0
 :EndTrap

 token←{2=payload.⎕NC'token':payload.token ⋄ ''}⍬
 :If 0=≢token
     :Trap 0
         auth←r.GetHeader'authorization'
         :If 7≤≢auth
         :AndIf 'BEARER '≡7↑⎕C auth
             token←7↓auth
         :EndIf
     :EndTrap
 :EndIf

 :If ~expected≡token
     r.Response.StatusCode←401
     r←'{"ok":false,"error":"unauthorized"}'
     →0
 :EndIf

 :If 2≠payload.⎕NC'secrets'
     r.Response.StatusCode←400
     r←'{"ok":false,"error":"missing secrets object"}'
     →0
 :EndIf
 secrets←payload.secrets

 pool←⎕A,⎕D
 code←∊pool[?24⍴≢pool]
 pending←⎕NS''
 pending.code←code
 pending.secrets←secrets
 pending.created←20 ⎕DT⊂⎕TS

 ids←secrets.⎕NL ¯2
 summary←''
 :For id :In ids
     sec←secrets⍎id
     flds←sec.⎕NL ¯2
     line←''
     :For i :In ⍳≢flds
         line,←(i>1)/', '
         line,←i⊃flds
     :EndFor
     summary,←id,': ',line,⎕UCS 13 10
 :EndFor

 cfgRoot←{9=#.⎕NC'ConfigRoot':#.ConfigRoot ⋄ #.Home,'Config/'}⍬
 f←cfgRoot,'secrets.pending.json5'
 :Trap 0
     (⊂(⎕JSON⍠'Compact' 0)pending)⎕NPUT f 1
 :Else
     r.Response.StatusCode←500
     r←'{"ok":false,"error":"failed writing pending secrets file"}'
     →0
 :EndTrap

 ok←SecretUpdateSendMail 'Confirm secret update'('A secret update request is waiting for confirmation.',⎕UCS 13 10,
     'Code: ',code,⎕UCS 13 10,
     'Apply with POST /secret_update_confirm and body {"code":"',code,'"}',⎕UCS 13 10,⎕UCS 13 10,
     'Requested keys:',⎕UCS 13 10,summary)
 :If ~ok
     r.Response.StatusCode←500
     r←'{"ok":false,"error":"failed sending confirmation email"}'
     →0
 :EndIf

 r.Response.StatusCode←200
 r←'{"ok":true,"pending":true}'
