 r←{l}secret_update_confirm r;payload;code;f;pending;secrets;fout;applied;cfgRoot
⍝ Confirm and activate a staged secret update.
⍝ Request JSON body: {"code":"<confirmation code>"}

 :Trap 0
     payload←⎕JSON r.Body
 :Else
     r.Response.StatusCode←400
     r←'{"ok":false,"error":"invalid JSON body"}'
     →0
 :EndTrap

 code←{2=payload.⎕NC'code':payload.code ⋄ ''}⍬
 :If 0=≢code
     r.Response.StatusCode←400
     r←'{"ok":false,"error":"missing code"}'
     →0
 :EndIf

 cfgRoot←{9=#.⎕NC'ConfigRoot':#.ConfigRoot ⋄ #.Home,'Config/'}⍬
 f←cfgRoot,'secrets.pending.json5'
 :If ~⎕NEXISTS f
     r.Response.StatusCode←404
     r←'{"ok":false,"error":"no pending update"}'
     →0
 :EndIf

 :Trap 0
     pending←(⎕JSON⍠'Dialect' 'JSON5')1⊃⎕NGET f
 :Else
     r.Response.StatusCode←500
     r←'{"ok":false,"error":"failed reading pending file"}'
     →0
 :EndTrap

 :If (~2=pending.⎕NC'code')∨~code≡pending.code
     r.Response.StatusCode←401
     r←'{"ok":false,"error":"invalid confirmation code"}'
     →0
 :EndIf

 :If 2≠pending.⎕NC'secrets'
     r.Response.StatusCode←500
     r←'{"ok":false,"error":"pending file invalid"}'
     →0
 :EndIf
 secrets←pending.secrets

 fout←cfgRoot,'secrets.local.json5'
 :Trap 0
     (⊂(⎕JSON⍠'Compact' 0)secrets)⎕NPUT fout 1
 :Else
     r.Response.StatusCode←500
     r←'{"ok":false,"error":"failed writing secrets file"}'
     →0
 :EndTrap

 applied←ApplySecrets secrets
 :Trap 0
     #.SecretsUTC←⊃13 ⎕NINFO fout
 :EndTrap
 :Trap 0
     ⎕NDELETE f
 :EndTrap

 r.Response.StatusCode←200
 r←'{"ok":true,"applied":',⍕applied,'}'
