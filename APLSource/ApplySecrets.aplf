 applied←ApplySecrets secrets;ids;id;sec;flds;fld;val;cfgIds;i;ref;inst;hdl
⍝ Merge secrets into trigger config and live instances/handlers.
⍝ ⍵ is expected to be a namespace/object: { TriggerId: { key: value, ... }, ... }
 applied←0
 :If 0=≢,⍕secrets
     →0
 :EndIf
 :Trap 0
     ids←secrets.⎕NL ¯2
 :Else
     →0
 :EndTrap
 :If 0=≢ids
     →0
 :EndIf
 cfgIds←#.Triggers.Config.⎕NL ¯9
 :For id :In ids
     :If ~((⊂id)∊cfgIds)
         :Continue
     :EndIf
     ref←#.Triggers.Config⍎id
     sec←secrets⍎id
     :Trap 0
         flds←sec.⎕NL ¯2
     :Else
         :Continue
     :EndTrap
     i←cfgIds⍳⊂id
     :For fld :In flds
         val←sec⍎fld
         :Trap 0
             fld ref.config.{⍎⍺,'←⍵'}val
             applied+←1
         :EndTrap
         :Trap 0
             :If 2=ref.⎕NC'handler_cfg'
                 fld ref.handler_cfg.{⍎⍺,'←⍵'}val
             :EndIf
         :EndTrap
         :Trap 0
             :If i≤≢#.Triggers.instances
                 inst←i⊃#.Triggers.instances
                 :If 2=inst.⎕NC'ns'
                 :AndIf 2=inst.ns.⎕NC'config'
                     fld inst.ns.config.{⍎⍺,'←⍵'}val
                 :ElseIf 2=inst.⎕NC'config'
                     fld inst.config.{⍎⍺,'←⍵'}val
                 :EndIf
             :EndIf
         :EndTrap
         :Trap 0
             :If i≤≢#.Triggers.handlers
                 hdl←i⊃#.Triggers.handlers
                 :If 2=hdl.⎕NC'cfg'
                     fld hdl.cfg.{⍎⍺,'←⍵'}val
                 :EndIf
             :EndIf
         :EndTrap
     :EndFor
 :EndFor
