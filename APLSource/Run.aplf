 Run nul;z;ns;check_freq;cls;ref;trigger;trg;Home;config;rules;pckgs;mkt;p;ARG;hdl;project_dir;ct;cfg;FixEnvRefs;i;JARVIS_URL;JarvisConfig;jarvis_callbacks;Trapping;codeDir;ConfigRoot;cfgEnv;cfgRulesFile;cfgTriggersFile;cfgMainFile;EnsureSlash;cb;cbfn;call;Handler;res;hdl_idx
⍝ Initialises eventler and starts the main "listinging loop"
⍝  Home←1⊃1 ⎕NPARTS 50 ⎕ATX 1⊃⎕SI  ⍝
⍝  Home←1⊃⎕NPARTS ¯1↓Home          ⍝ "#.Home" refers to Eventler's rootDir  (while we load from the APLSource folder)
 ⎕SE.SESSIONSTART←'*** Konducta *** ',⍕⎕TS
 DATA←{⍵,(~⍵[≢⍵]∊'\/')/'/'}2 ⎕NQ'.' 'GetEnvironment' 'KONDUCTA_DATA'
⍝  #.Home←Home
⍝  ⎕←'Home=',Home

 EnsureSlash←{0=≢⍵:'' ⋄ ⍵,(~⍵[≢⍵]∊'\/')/'/'}
 cfgEnv←2 ⎕NQ'.' 'GetEnvironment' 'KONDUCTA_CONFIG'
 #.Home←Home←1⊃⎕NPARTS cfgEnv
 ⎕←'Home=',Home
 ConfigRoot←EnsureSlash cfgEnv
 :If 0=≢ConfigRoot
     ConfigRoot←Home,'Config/'
 :EndIf
 #.ConfigRoot←ConfigRoot
 (cfgRulesFile cfgTriggersFile cfgMainFile)←ConfigRoot∘,¨'rules.json5' 'triggers.json5' 'konducta.json5'
 ⎕←'ConfigRoot=',ConfigRoot


 :If 0=#.⎕NC'launchTS'
     #.launchTS←20 ⎕DT⊂⎕TS
 :EndIf
 :If ~⎕NEXISTS dir←DATA ⋄ ⎕MKDIR dir ⋄ :EndIf
 :If ~⎕NEXISTS dir←DATA,'/evq/' ⋄ ⎕MKDIR dir ⋄ :EndIf
 :If ~⎕NEXISTS dir←DATA,'/evq/done' ⋄ ⎕MKDIR dir ⋄ :EndIf
 :If ~⎕NEXISTS dir←DATA,'/trash' ⋄ ⎕MKDIR dir ⋄ :EndIf

 :If 0<z←≢⊃0(⎕NINFO⍠1)DATA,'/evq/*.json5'
     (⎕NDELETE⍠'Wildcard' 1)DATA,'/evq/*.json5'
     ⎕←'Deleted ',(⍕z),' old files from queue during startup'
 :EndIf
 ⎕SE.Link.Import(1⊃160⌶'DYALOG'),'/Library/Core/APLProcess.dyalog'



 rules←⎕JSON readConfig cfgRulesFile
 #.Triggers.Config←⎕JSON readConfig cfgTriggersFile   ⍝ read config file
 #.Config←⎕JSON readConfig cfgMainFile   ⍝ read config file
 :If 3=#.⎕NC'ApplySecretsIfChanged'
     {}ApplySecretsIfChanged ⍬
 :EndIf
 Trapping←#.Config{6::0 ⋄ ⍺⍎⍵}'Trapping'
 #.HTMLFOLDER←(⎕MKDIR⍠'Unique' 1)(739⌶0),'/Konducta_HTML_'   ⍝ might be used by handlers to store html files for delivery via Jarvis (or similar)

 ⍝ Load handler repositories from config (new modular approach)
 :If 2=#.Config.⎕NC'handlerRepos'
 :AndIf 0<≢#.Config.handlerRepos
     LoadHandlerRepos #.Config.handlerRepos
 :Else
     ⎕←'"handlerRepos" not found in config or empty, skipping loading handler repositories'
 :EndIf
 jarvis_callbacks←⍬
 check_freq←⌊/⍬
 #.Triggers.(list instances handlers)←⊂⍬
 '#.Triggers.handlerMap'⎕NS''
 :For ns :In #.Triggers.Config.⎕NL ¯9
     ⎕←'setup ',ns
⍝     ∘∘∘
     :If ~#.Triggers.Config{6::0 ⋄ ⍺⍎⍵}ns,'.disabled'
         ⍎'#.Triggers.Config.',ns,'.config.id←ns'
         ⍎'#.Triggers.Config.',ns,'.config.Folder←''',DATA,'/',ns,'/',''''
         ref←Triggers.Config.⍎ns
         3 ⎕MKDIR ⎕←ref.config.Folder  ⍝ be sure that Folder exists
         hdl←ref.handler
         hdlClass←ResolveHandler hdl
         ⎕←'Handler = ⎕NEW ',hdlClass,'(ref.handler_cfg ns ref)'
         hdl←⎕NEW hdlClass(ref.handler_cfg ns ref)
         #.Triggers.handlers,←hdl
         hdl_idx←≢#.Triggers.handlers
         ⍎'#.Triggers.handlerMap.',ns,'←hdl'
         cls←('#.Triggers.'{⍺,⍵,'.',⍵}' '~⍨⍕ref.type)
         #.Triggers.list←⊂⎕←'⎕NEW ',cls,' #.Triggers.Config.',ns,'.config'
         #.Triggers.instances,←r2←⍎⊃¯1↑#.Triggers.list
         hdl.TheInstance←r2
         r2.Loc←ns
         check_freq←check_freq⌊ref{6::⌊/⍬ ⋄ ⍎'⍺.',⍵}'check_freq_secs'
         :If 2=ref.⎕NC'jarvis_callbacks'
         :AndIf 0<≢ref.jarvis_callbacks
             :If ∨/z←(⊆ref.jarvis_callbacks)∊1↑¨jarvis_callbacks
                 ⎕←'*** Attempt to register duplicate Jarvis callback(s): ',z/⊆ref.jarvis_callbacks
             :EndIf
             jarvis_callbacks,←(~z)/(⊂¨⊆ref.jarvis_callbacks),¨hdl_idx
         :EndIf
     :EndIf
 :EndFor

 :If 3=#.⎕NC'secret_update'
 :AndIf ~(⊂'secret_update')∊jarvis_callbacks
     jarvis_callbacks,←⊂'secret_update' '#'
 :EndIf

 :If 3=#.⎕NC'secret_update_confirm'
 :AndIf ~(⊂'secret_update_confirm')∊jarvis_callbacks
     jarvis_callbacks,←⊂'secret_update_confirm' '#'
 :EndIf

 :If 0<≢jarvis_callbacks
⍝ we need Jarvis! so lets launch it
⍝TODO: we also need it if there are any html pages to deliver!
     '#.CodeLocation'⎕NS''
⍝ and create those callback-functions
⍝ #.CodeLocation.⎕FX¨{3=#.⎕NC ⍵:⎕NR'#.',⍵ ⋄ 'l #.jarvis_callback2Q r' '∇'}¨jarvis_callbacks
     :For cb :In jarvis_callbacks
         :If '#'≡2⊃cb
         :AndIf 3=#.⎕NC 1⊃cb
             #.CodeLocation.⎕FX #.⎕NR 1⊃cb
         :Else
             'DBG' 'SYS'(1⊃#.Triggers.handlers).Log'Creating callback function for Jarvis: ',1⊃cb
             cbfn←⊂'{R}←{l} ',(1⊃cb),' r;n'
             cbfn,←⊂'R←0'   ⍝ default
             cbfn,←⊂'n←⎕UCS 10 ⋄ (⊂''Body:'',n,⍕((⎕JSON⍠''Compact'' 0)r),n,''Headers'',n,,l.Headers,n)⎕NPUT ⎕←#.DATA,,''<webhooks/>,ZI4,ZI2,ZI2,<->,ZI2,ZI2,ZI2,<.json>''⎕FMT 1 6⍴⎕TS    ⍝ log r (Request Body) and l.Headers'
             call←'(',(⍕2⊃cb),'⊃#.Triggers.handlers).',1⊃cb
             res←''
             :If 1=|10(⍎{(¯1+⌈/⍸⍵='.')↑⍵}call).⎕ATX 1⊃cb ⋄ res←'R←' ⋄ :EndIf  ⍝ catch result if there is one
             cbfn,←⊂':if 0<⎕nc''l'''
             cbfn,←⊂res,'l ',call,' r'
             cbfn,←⊂':else'
             cbfn,←⊂res,'     ',call,' r'
             cbfn,←⊂':endIf'
             res←#.CodeLocation.⎕FX cbfn
             :If res≢1⊃cb
                 ⎕←'Error creating callback function for Jarvis: ',1⊃cb,' (',res,')'
                 ∘∘∘
             :EndIf
         :EndIf
     :EndFor

   ⍝ and configure it
     'JarvisConfig'⎕NS''
     JarvisConfig.CodeLocation←#.CodeLocation
     JarvisConfig.(Port Secure)←#.Triggers.Config.(JarvisPort,{6::0 ⋄ ⍎w}'JarvisSecure')
     JarvisConfig.Paradigm←'JSON'
     :If 0<≢⊃0(⎕NINFO⍠1)HTMLFOLDER,'/*'
         JarvisConfig.HTMLInterface←HTMLFOLDER
     :EndIf
     JarvisConfig.HTMLDefaultPage←''
     JarvisConfig.Jarvis_Thread←0
     JarvisConfig.AllowGETs←1  ⍝ allow calling endpoints with Http-GET
     JarvisConfig.Debug←#.Triggers.Config'JarvisDebug'{0=(1⊃⍺).⎕NC 2⊃⍺:⍵ ⋄ ⍎/⍺}0
⍝ should add ValidateRequest and check for some credentials to make it harder to hack
     #.jarvis←#.Jarvis.New JarvisConfig
     :If 0≠⊃⎕←#.jarvis.Start
         ∘∘∘
     :EndIf
     #.JARVIS_URL←'http://',#.Triggers.Config.JarvisHost,((#.Triggers.Config.JarvisPort≠80)/':',(⍕#.Triggers.Config.JarvisPort)),'/'
 :EndIf

 codeDir←EnsureSlash 2 ⎕NQ'.' 'GetEnvironment' 'KONDUCTA_ROOT'
 :If 0=≢codeDir
     codeDir←Home
 :EndIf
 'INFO' 'SYS'(⊃#.Triggers.handlers).Log'Started Konducta v',Version codeDir

⍝ aktualisierung triggers umschreiben!!! (entweder anfang oder ende, aber nicht 2*!)
⍝ update list of events
⍝ (record into file or variable?)
 :Trap 802 803
     :Trap 801,Trapping/0
         :If check_freq<⌊/⍬  ⍝ do we have anything to watch?
             :Repeat
                 i←0
                 :For trg :In #.Triggers.list
            ⍝ this logic recreates instances with every loop!
            ⍝ that's a bit too costly (with NuGet etc.)
            ⍝ maybe we should re-create instances only if config was changed! (keep a timestamp of config files in instance...)
            ⍝ (for the initial proof of concept this is fine, but should be addressed later!)
                     i+←1

                     Handler←i⊃#.Triggers.handlers  ⍝ "Handler" might be used  in rules or "Run"
                     'DBG' 'SYS'Handler.Log'───────── Next round for handler: ',⍕Handler
                     ⎕←'trg='
                     ref←i⊃#.Triggers.instances   ⍝ see initial comments about re-creating instances only when needed!
                     :If 0<≢events←ref⍎'Run ⍬'
               ⍝ add to queue...
                         add2Q¨events
                     :EndIf
                     ⎕←'≢events=',≢events
                 :EndFor
                 procEvents
                 ref←Triggers.Config⍎ns
                 :If #.Config.(UTC<⊃13 ⎕NINFO File)  ⍝ check if config was updated so that we need to re-read the files...
                     #.Config←⎕JSON #.readConfig cfgMainFile
                     'INFO' 'SYS'Handler.Log #.Config.File,' updated, re-reading...'
                 :EndIf
                 :If #.Triggers.Config.(UTC<⊃13 ⎕NINFO File)  ⍝ check if config was updated so that we need to re-read the files...
                     'INFO' 'SYS'Handler.Log #.Triggers.Config.File,' updated, re-reading...'
                     #.Triggers.Config←⎕JSON #.readConfig cfgTriggersFile   ⍝ read config file
                     :For ns :In #.Triggers.Config.⎕NL ¯9
                         :If ~#.Triggers.Config{6::0 ⋄ ⍺⍎⍵}ns,'.disabled'
                             ⍎'#.Triggers.Config.',ns,'.config.id←ns'
                             ⍎'#.Triggers.Config.',ns,'.config.Folder←''',DATA,'/',ns,'/',''''
                         :EndIf
                     :EndFor
                 :EndIf
                 :If rules.(UTC<⊃13 ⎕NINFO File)
                     'INFO' 'SYS'Handler.Log rules.file,' updated, re-reading...'
                     rules←⎕JSON #.readConfig cfgRulesFile
                 :EndIf
                 :If 3=#.⎕NC'ApplySecretsIfChanged'
                     {}ApplySecretsIfChanged ⍬
                 :EndIf
                 :If #.Config.debug _hasBitSet 3
                     (⎕LC[1]+1)⎕STOP 1⊃⎕SI
                     ⎕←'Stopping after execution of one loop as request by Config.debug'
                 :Else
                     ⎕DL check_freq  ⍝ wait...
                 :EndIf
             :Until 0
         :EndIf
     :Else
         :Select ⎕EN
         :Case 801   ⍝ RESTART Event (triggered by GITUPD)
             'DBG' 'SYS'(⊃#.Triggers.handlers).Log'Restart event was triggered'
             →1
         :EndSelect
     :EndTrap
 :Case 802 ⍝ DETRAP
     Trapping←0
     'INFO' 'SYS'(⊃#.Triggers.handlers).Log'Disabled trapping'
 :Case 803 ⍝ RETRAP
     Trapping←1
     'INFO' 'SYS'(⊃#.Triggers.handlers).Log'Enabled trapping'
 :EndTrap
