:class KonductaHandler
    :field public txt_ns
    :field public cfg
    :field public CFG
    :field public TheInstance
    :field public shared version←'N/A'

    ∇ SetVersion v
      :Access public shared
      version←v
    ∇

    ∇ R←RMB R
      :Access public
      R←' '(1↓,⊢⍤/⍨1(⊢∨⌽)0,≠)R
    ∇

    ∇ R←myBase
      :Access public
      :If 0=≢txt_ns
          11 ⎕SIGNAL'Can not determine base ns w/o txt_ns!'
      :EndIf
      R←txt_ns.##
    ∇

    ∇ txt←⍙ id;values;ns;i;replace⍙;lang;base;file
      :Access public
⍝ return text with given id
⍝ look in namespace for current language first, use "en" as fallback
⍝ optionally may contain "fill values" for placeholders ("%" or "%1" etc.)
      :If 1<|≡id
          values←⍕¨1↓id
          id←1⊃id
      :Else
          values←⍬
      :EndIf
      lang←cfg.##.handler_cfg.lang
      :If 2=(ns←txt_ns⍎lang).⎕NC id
          txt←ns⍎id
      :ElseIf 2=(ns←txt_ns⍎'en').⎕NC id
          lang←'en'
          txt←ns⍎id
      :Else ⍝*** id not found!
          'ERR' 'SYS'Log'⍙''',id,''' not found!'
          txt←id              ⍝ return id as text
      :EndIf

      :If (⎕UCS 65533)∊∊txt
          ⍝ Some platforms may import UTF-8 .apla text resources with the wrong default
          ⍝ encoding. Re-read the source file explicitly as UTF-8 before placeholders expand.
          base←myBase
          :If 2=base.⎕NC'RepoPath'
              file←base.RepoPath,'APLSource/alisia_texts/',lang,'/',id,'.apla'
              :If ⎕NEXISTS file
                  :Trap 0
                      txt←⍎⊃'UTF-8'⎕NGET file
                      id ns.{⍎⍺,'←⍵'}txt
                      'WARN' 'SYS'Log'Reloaded UTF-8 text resource after U+FFFD detection: ',file
                  :Else
                      'WARN' 'SYS'Log'Could not reload UTF-8 text resource: ',file
                  :EndTrap
              :EndIf
          :EndIf
      :EndIf
     
      :For i :In ⍳{0=≢⍵:0 ⋄ ≢⊆⍵}values
          txt←(('%',⍕i)⎕R(i⊃values)⍠'Regex' 0)txt
          :If 1=≢⊆values
              txt←('%'⎕R(1⊃values)⍠'Regex' 0)txt
          :EndIf
      :EndFor
     
      ⍝ finally: check if there are any ⍙id⍙ sequences in the result and replace them with the text they refer to
      ⍝ maybe: also allow ⍙%var⍙ to refer to envvars?
      replace⍙←{(1 ⎕C 2⊃⍵.Match)∊⎕A:⍙ 1↓¯1↓⍵.Match}
      :If '⍙'∊∊txt
          txt←('⍙([^⍙]*)⍙'⎕R replace⍙)txt
      :EndIf
    ∇


    ∇ z←Trash E
      :Access public
⍝ Event E is not relevant - move to trash
      ⎕←'[Trash] unbekannter Absender: ',E.sender,' / Betreff: ',E.subject
      3 ⎕MKDIR #.DATA,'/trash/'  ⍝ make sure we have a trash folder
      :If ~∨/{⎕NEXISTS #.DATA,'/trash/',⍵}¨∊¨1↓¨⎕NPARTS¨E.(EventQueue_File Filename)
          ⎕←'[Trash] verschiebe: ',E.EventQueue_File
          ⎕←'[Trash] verschiebe: ',E.Filename
          (#.DATA,'/trash/')⎕NMOVE E.EventQueue_File
          (#.DATA,'/trash/')⎕NMOVE E.Filename
      :Else
          ⎕←'[Trash] Dateien bereits im Trash-Ordner, überspringe'
      :EndIf
      z←1
    ∇

    ∇ {r}←{lv_cat}Log msg
      :Access public
      ⍝ Delegate to #.Log with this handler's folder and cfg
      r←lv_cat #.Log(msg CFG.config.Folder cfg)
    ∇

    ∇ txt←{days}GetLogs flt;offset;d;logf;rawlog
      :Access public
      ⍝ Collect log entries from the last {days - default and max=7} daily JSONL files and apply filter.
      ⍝ flt: lowercase filter string — exact match on level (err/warn/info/dbg),
      ⍝      category (sys/sub/adm/smtp/bounce/sec), or free-text substring.
      ⍝ Returns nested vector of raw JSON strings, or ⍬ if nothing found.
      txt←⍬
      ⎕USING∪←⊂'System,System.Runtime'
      :For offset :In ⌽0∪{6::6 ⋄ 0⌈6⌊⍎⍵}'days'
          d←DateTime.Today.AddDays(-offset)
          logf←CFG.config.Folder,'log-',(⍕d.Year),(¯2↑'0',⍕d.Month),(¯2↑'0',⍕d.Day),'.jsonl'
          :If ~⎕NEXISTS logf ⋄ :Continue ⋄ :EndIf
          rawlog←(⎕UCS 10)#.split(1⊃⎕NGET logf)~⎕UCS 13
          txt←txt,((0<≢¨rawlog)/rawlog)
      :EndFor
      :If 0=≢txt ⋄ →0 ⋄ :EndIf
      :If 0<≢flt
          :If (⊂flt)∊'err' 'warn' 'info' 'dbg'
              txt←(∨/¨(⊂'"level":"',flt,'"')⍷⍥⎕C¨txt)/txt
          :ElseIf (⊂flt)∊'sys' 'sub' 'adm' 'smtp' 'bounce' 'sec'
              txt←(∨/¨(⊂'"cat":"',flt,'"')⍷⍥⎕C¨txt)/txt
          :Else
              txt←(∨/¨(⊂flt)⍷⍥⎕C¨txt)/txt
          :EndIf
      :EndIf
    ∇

    ∇ r←d1 DateDiff d2;⎕USING;dt1;dt2
      :Access public
      ⍝ Return difference of Dyalog date numbers as (Days Hours Minutes).
      ⍝ #TODO: calculate exact year difference (considering leap years)
      ⎕USING←'System'
      dt1←⎕NEW DateTime(⊃20 ¯1 ⎕DT d1)
      dt2←⎕NEW DateTime(⊃20 ¯1 ⎕DT d2)
      r←(dt1.Subtract dt2).(Days Hours Minutes)
    ∇

    ∇ ENDRULE nul
      :Access public
      ⎕SIGNAL 998  ⍝ end processing of current rule
    ∇

    ∇ z←IsDevUser email
      :Access public
      email←⊃⊆email  ⍝ handle possible nested case
      z←(⊂⎕C #.getMaddr email)∊⊆#.Config.devs
      'DBG' 'SYS'Log'IsDevUser, email=',email,' => ',⍕z
    ∇

    ∇ R←FirstWord R
      :Access public
      R←RMB R
      R←(¯1+R⍳' ')↑R
    ∇

:endclass
